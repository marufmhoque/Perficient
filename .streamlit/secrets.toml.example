# Copy to .streamlit/secrets.toml (git-ignored) for local runs.
# On Streamlit Community Cloud paste these into: App -> Settings -> Secrets.

# Required: Claude API key (https://platform.claude.com)
ANTHROPIC_API_KEY = "sk-ant-..."

# Optional: raises the NCBI E-utilities limit from 3 to 10 requests/second
# NCBI_API_KEY = ""

# Optional: SEC asks automated clients to identify themselves, e.g. "YourOrg contact@yourdomain.com"
# SEC_USER_AGENT = ""

# Optional model overrides
# AGENT_MODEL = "claude-sonnet-5-5"
# AGGREGATOR_MODEL = "claude-opus-5-5"
